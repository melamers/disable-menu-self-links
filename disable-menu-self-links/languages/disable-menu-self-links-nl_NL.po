#. Plugin Name of the plugin
msgid "Disable Menu Self Links"
msgstr ""

#. Description of the plugin
msgid "Optionally disable self-referencing links in WordPress menus using self-anchors with multiple fallback protections."
msgstr "Maak links naar de pagina waar je al bent optioneel onklikbaar, met meerdere lagen bescherming."

#: disable-menu-self-links.php:266
msgid "Disable Link to Self"
msgstr "Link naar deze pagina uitschakelen"

#: disable-menu-self-links.php:269
msgid "When checked, the link will not be clickable when viewing this page."
msgstr "Als dit is aangevinkt, is de link niet klikbaar wanneer je deze pagina bekijkt."
